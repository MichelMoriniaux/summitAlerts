# --- Summit Control login (same as https://account.summitcontrol.com) ---
SUMMIT_USERNAME=
SUMMIT_PASSWORD=

# --- Email (example: Gmail with an App Password, https://myaccount.google.com/apppasswords) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@gmail.com
# Comma-separated list of recipients
ALERT_TO=you@gmail.com

# --- Behaviour ---
# Seconds between checks (one API call each). 600 = every 10 minutes.
POLL_INTERVAL_SECONDS=600
# Consecutive "down" checks required before emailing (avoids alerts on brief blips).
CONFIRM_POLLS=2
# Also treat a gate as down if "last seen" is older than this many minutes. 0 = off.
STALE_MINUTES=0
# Only watch these devices (comma-separated names as shown on the dashboard). Empty = all.
DEVICE_NAMES=
# Email you if the monitor itself fails this many checks in a row.
ERROR_ALERT_AFTER=6
# How often to re-discover which sites your account has.
SITE_REFRESH_HOURS=24
LOG_LEVEL=INFO
# Timezone used for times in logs and emails
TZ=America/Los_Angeles
